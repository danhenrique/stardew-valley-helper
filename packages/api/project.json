{
  "name": "stardew_valley_helper.stardew_valley_api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/api/stardew_valley_api",
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  },
  "tags": [],
  "metadata": {
    "generator": "py#fast-api",
    "ports": [8001],
    "apiName": "stardew-valley-api",
    "apiType": "fast-api",
    "auth": "iam",
    "iac": "terraform",
    "components": [
      {
        "generator": "py#dynamodb#fast-api-connection",
        "path": "packages/db",
        "name": "stardew_valley_helper.stardew_valley_db"
      }
    ]
  },
  "targets": {
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "assemble": {
      "dependsOn": ["compile", "bundle", "openapi"]
    },
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        "typecheck",
        "bundle",
        "openapi"
      ],
      "inputs": ["default", "^production"],
      "outputs": [],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}"
      }
    },
    "bundle": {
      "dependsOn": ["bundle-x86"]
    },
    "bundle-x86": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle-x86"],
      "options": {
        "commands": [
          "uv export --frozen --no-dev --no-editable --project {projectRoot} --package stardew_valley_helper.stardew_valley_api -o dist/{projectRoot}/bundle-x86/requirements.txt",
          "uv pip install -n --no-deps --no-installer-metadata --no-compile-bytecode --python-platform x86_64-manylinux_2_28 --python-version 3.14 --target dist/{projectRoot}/bundle-x86 -r dist/{projectRoot}/bundle-x86/requirements.txt",
          "shx cp {projectRoot}/run.sh dist/{projectRoot}/bundle-x86/run.sh"
        ],
        "parallel": false
      }
    },
    "compile": {
      "executor": "@nxlv/python:build",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}/build",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true,
        "ignorePaths": [
          ".venv",
          ".tox",
          "tests",
          "__pycache__",
          ".coverage",
          ".coverage.*",
          ".pytest_cache",
          "pytest-cache-files-*",
          ".ruff_cache"
        ]
      }
    },
    "dev": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": [
        {
          "projects": ["stardew_valley_helper.stardew_valley_db"],
          "target": "dev"
        }
      ],
      "continuous": true,
      "options": {
        "command": "uv run fastapi dev stardew_valley_api/main.py --port 8001",
        "cwd": "{projectRoot}",
        "env": {
          "LOCAL_DEV": "true"
        }
      }
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "filePatterns": ["stardew_valley_api", "tests"],
        "check": true
      },
      "configurations": {
        "fix": {
          "check": false
        },
        "skip-lint": {
          "check": false
        }
      }
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "dependsOn": ["format"],
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [],
      "options": {
        "lintFilePatterns": ["stardew_valley_api", "tests"]
      },
      "configurations": {
        "fix": {
          "fix": true
        },
        "skip-lint": {
          "exitZero": true
        }
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "openapi": {
      "cache": true,
      "inputs": ["production", "^production"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/openapi"],
      "options": {
        "commands": [
          "uv run python {projectRoot}/scripts/generate_open_api.py \"dist/{projectRoot}/openapi/openapi.json\""
        ]
      }
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "serve": {
      "executor": "@nxlv/python:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run fastapi dev stardew_valley_api/main.py --port 8001",
        "cwd": "{projectRoot}"
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "cache": true,
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run ty check",
        "cwd": "{projectRoot}"
      }
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    }
  }
}
