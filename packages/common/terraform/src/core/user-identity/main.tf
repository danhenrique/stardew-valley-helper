variable "enable_waf" {
  description = "Whether to enable AWS WAFv2 with the default managed ruleset and associate it with the user pool"
  type        = bool
  default     = true
}

variable "mfa" {
  description = "Whether users must configure MFA, may optionally configure MFA, or cannot use MFA at all"
  type        = string
  default     = "ON"

  validation {
    condition     = contains(["OFF", "OPTIONAL", "ON"], var.mfa)
    error_message = "mfa must be one of OFF, OPTIONAL, ON"
  }
}

variable "mfa_second_factor_otp" {
  description = "Whether users can use a time-based one time password (TOTP), generated by a hardware or software token, as an MFA method"
  type        = bool
  default     = true
}

variable "mfa_second_factor_sms" {
  description = "Whether users can use SMS to their verified phone numbers as an MFA method. Due to a Terraform AWS provider limitation, disabling this also disables SMS-based phone number verification, unlike the equivalent CDK construct prop"
  type        = bool
  default     = true
}

variable "callback_urls" {
  description = "OAuth callback URLs for the user pool web client (e.g. the website's custom domain)"
  type        = list(string)
  default     = []
}

variable "logout_urls" {
  description = "OAuth logout URLs for the user pool web client"
  type        = list(string)
  default     = []
}

variable "managed_login_domain" {
  description = "Optional custom domain serving the managed login (e.g. auth.example.com), published to the runtime config so the website redirects there. The domain itself is created by the caller"
  type        = string
  default     = null
}

module "identity" {
  source = "./identity"

  # Frozen: physical name from aws-danhenrique; renaming replaces the resource
  user_pool_domain_prefix = "danhenrique-stardew-valley-helper-website"
  allow_signup            = true
  enable_waf              = var.enable_waf
  mfa                     = var.mfa
  mfa_second_factor_otp   = var.mfa_second_factor_otp
  mfa_second_factor_sms   = var.mfa_second_factor_sms
  callback_urls           = var.callback_urls
  logout_urls             = var.logout_urls
  managed_login_domain    = var.managed_login_domain
}

# Outputs
output "region" {
  description = "AWS region"
  value       = module.identity.region
}

output "user_pool_id" {
  description = "ID of the Cognito User Pool"
  value       = module.identity.user_pool_id
}

output "user_pool_arn" {
  description = "ARN of the Cognito User Pool"
  value       = module.identity.user_pool_arn
}

output "user_pool_client_id" {
  description = "ID of the Cognito User Pool Client"
  value       = module.identity.user_pool_client_id
}

output "identity_pool_id" {
  description = "ID of the Cognito Identity Pool"
  value       = module.identity.identity_pool_id
}

output "authenticated_role_name" {
  description = "Name of the authenticated IAM role"
  value       = module.identity.authenticated_role_name
}

output "authenticated_role_arn" {
  description = "ARN of the authenticated IAM role"
  value       = module.identity.authenticated_role_arn
}

output "user_pool_domain" {
  description = "Domain of the Cognito User Pool"
  value       = module.identity.user_pool_domain
}
